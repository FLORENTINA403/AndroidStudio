<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pdf_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_margin="16dp"
    android:background="?attr/selectableItemBackground"
    android:elevation="4dp">

    <!-- Title Full Width -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📄 Applicant Details"
        android:textStyle="bold"
        android:textColor="#0077B6"
        android:textSize="24sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Two-column grid for details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/applicant_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@drawable/edittext_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/applicant_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="16sp"
                android:textColor="#444444"
                android:background="@drawable/edittext_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/applicant_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ID"
                android:textSize="16sp"
                android:textColor="#444444"
                android:background="@drawable/edittext_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/applicant_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textSize="16sp"
                android:textColor="#444444"
                android:background="@drawable/edittext_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/applicant_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Level"
                android:textSize="16sp"
                android:textColor="#444444"
                android:background="@drawable/edittext_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/applicant_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Field"
                android:textSize="16sp"
                android:textColor="#444444"
                android:background="@drawable/edittext_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- PDF Button full width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/view_pdf_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View PDF"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0077B6"
            android:elevation="2dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>
</LinearLayout>
