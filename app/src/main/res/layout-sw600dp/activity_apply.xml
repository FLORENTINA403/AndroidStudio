<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/apply_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="48dp"
    tools:context=".ActivityApply">

<LinearLayout
android:layout_width="720dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal">

    <!-- Toolbar -->
<androidx.appcompat.widget.Toolbar
android:id="@+id/toolbar_signup"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="#1B4965"
android:title="Sign Up"
android:titleTextColor="@android:color/white"
android:elevation="4dp"
app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Back arrow -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:padding="16dp"
android:gravity="center_vertical">
<ImageView
    android:id="@+id/back_button"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:src="@drawable/back"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:contentDescription="Back"
    android:padding="4dp"
    android:layout_marginEnd="8dp" />
</LinearLayout>

    <!-- Title -->
<TextView
android:id="@+id/signup_title"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Apply Here!"
android:textSize="28sp"
    android:textStyle="bold"
    android:textColor="#0A3E5F"
    android:layout_marginBottom="24dp" />

    <!-- Scholarship Type TextView -->
<EditText
android:id="@+id/scholarship_type_text"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="You are applying for: "
    android:textStyle="italic"
    android:textColor="#2c80a3"
    android:layout_marginBottom="32dp" />

    <!-- Inputs -->
<EditText
android:id="@+id/fullname_input"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Name"
android:inputType="textPersonName"
android:background="@drawable/edittext_background"
android:padding="16dp"
    android:layout_marginBottom="20dp"
    android:textColor="#000000"
    android:textColorHint="#808080" />

<EditText
android:id="@+id/lastname_input"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Last Name"
android:inputType="textPersonName"
android:background="@drawable/edittext_background"
android:padding="16dp"
android:layout_marginBottom="20dp"
android:textColor="#000000"
android:textColorHint="#808080" />

<EditText
android:id="@+id/email_input"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Email Address"
android:inputType="textEmailAddress"
android:background="@drawable/edittext_background"
android:padding="16dp"
android:layout_marginBottom="20dp"
android:textColor="#000000"
android:textColorHint="#808080" />

<EditText
android:id="@+id/id_input"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="ID"
android:inputType="number"
android:background="@drawable/edittext_background"
android:padding="16dp"
android:layout_marginBottom="20dp"
android:textColor="#000000"
android:textColorHint="#808080" />

<EditText
android:id="@+id/tel_input"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Phone Number"
android:inputType="number"
android:background="@drawable/edittext_background"
android:padding="16dp"
android:layout_marginBottom="20dp"
android:textColor="#000000"
android:textColorHint="#808080" />

<AutoCompleteTextView
android:id="@+id/level_autocomplete"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Select Level"
android:background="@drawable/edittext_background"
android:padding="16dp"
android:layout_marginBottom="20dp"
android:inputType="none"
android:focusable="false"
android:cursorVisible="false"
android:textColor="#000000"
android:textColorHint="#808080" />

<AutoCompleteTextView
android:id="@+id/field_autocomplete"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Select Field"
android:background="@drawable/edittext_background"
android:padding="16dp"
android:layout_marginBottom="32dp"
android:inputType="none"
android:focusable="false"
android:cursorVisible="false"
android:textColor="#000000"
android:textColorHint="#808080" />

    <!-- Upload -->
<Button
android:id="@+id/upload_pdf_button"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Upload PDF Document"
android:textColor="#2c80a3"
android:layout_marginTop="24dp" />

<TextView
android:id="@+id/file_name"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="No file selected"
android:textColor="#000000"
android:paddingTop="20dp" />

    <!-- Apply -->
<Button
android:id="@+id/apply_button"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="APPLY"
android:textAllCaps="true"
android:textColor="#FFFFFF"
android:backgroundTint="#227093"
android:padding="16dp"
android:layout_marginTop="12dp"
android:layout_marginBottom="24dp" />

    </LinearLayout>
    </ScrollView>
