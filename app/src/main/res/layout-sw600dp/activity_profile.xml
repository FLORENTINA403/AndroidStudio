<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".EditProfileActivity">

    <!-- 🔒 Logout Button -->
    <ImageView
        android:id="@+id/btn_logoutt"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/logout2"
        android:contentDescription="Logout"
        android:clickable="true"
        android:focusable="true"
        android:layout_margin="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 📄 Scrollable Form Centered -->
    <ScrollView
        android:id="@+id/scroll_profile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="32dp"
        app:layout_constraintTop_toBottomOf="@id/btn_logoutt"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/rounded_card_bg"
            android:padding="32dp"
            android:elevation="6dp">

            <!-- 👤 Profile Image -->
            <ImageView
                android:id="@+id/profile_image"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/user"
                android:contentDescription="Profile Image"
                android:background="@drawable/circle_background"
                android:padding="8dp"
                android:elevation="6dp"
                android:layout_marginBottom="32dp" />

            <!-- Full Name -->
            <EditText
                android:id="@+id/name_field"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/edittext_background"
                android:hint="Full Name"
                android:padding="16dp"
                android:textColor="#0D2B45"
                android:textColorHint="#BBBBBB"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="16dp" />

            <!-- Email -->
            <EditText
                android:id="@+id/email_field"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/edittext_background"
                android:hint="Email"
                android:padding="16dp"
                android:textColor="#0D2B45"
                android:textColorHint="#BBBBBB"
                android:fontFamily="@font/poppins_regular"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp" />

            <!-- Phone -->
            <EditText
                android:id="@+id/phone_field"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/edittext_background"
                android:hint="Phone Number"
                android:padding="16dp"
                android:textColor="#0D2B45"
                android:textColorHint="#BBBBBB"
                android:fontFamily="@font/poppins_regular"
                android:inputType="phone"
                android:layout_marginBottom="24dp" />

            <!-- ✅ Save/Edit Button -->
            <Button
                android:id="@+id/edit_profile_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Profile"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0077B6"
                android:fontFamily="@font/poppins_bold"
                android:paddingVertical="16dp"
                android:textSize="18sp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>


